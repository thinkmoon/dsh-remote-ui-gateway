{
  "name": "dsh-remote-gateway",
  "version": "0.3.0",
  "description": "DSH plugin: authenticated reverse proxy for the web GUI. Forwards the browser Host and Origin unchanged and publishes those names as DSH 0.2 trustedHosts so the connection fence admits the remote session.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "reverse-proxy",
    "gateway"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.20.0",
    "playwright": "^1.64.0",
    "typescript": "~5.7.2"
  },
  "license": "MIT"
}
